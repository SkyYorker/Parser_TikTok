# Google Sheets API Configuration
# Для работы с Google Sheets необходимо:
# 1. Создать проект в Google Cloud Console (https://console.cloud.google.com/)
# 2. Включить Google Sheets API
# 3. Создать Service Account и скачать JSON ключ
# 4. Поделиться таблицей Google Sheets с email из Service Account
# 5. Скопировать этот файл в .env и заполнить реальными значениями

# Путь к файлу с credentials от Google Service Account
# Пример: credentials.json (если файл в корне проекта)
# Пример: path/to/credentials.json (если файл в другой папке)
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# ID таблицы Google Sheets (можно взять из URL таблицы)
# URL выглядит так: https://docs.google.com/spreadsheets/d/ВОТ_ЭТОТ_ID_ТУТ/edit
# Пример: 1aXhtbYzk2E5tet0QFj2d-nkDHEdiHJdfvp2-6W89eik
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Название листа в таблице (опционально, по умолчанию "Тушь TikTok")
# Если лист не существует, он будет создан автоматически
GOOGLE_SHEETS_WORKSHEET_NAME=Тушь TikTok
